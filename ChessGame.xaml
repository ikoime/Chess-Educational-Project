<Window x:Class="Chess_Educational_Project.ChessGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chess_Educational_Project"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
        mc:Ignorable="d"
        Title="Chess" Height="430" Width="630" Background="CornflowerBlue" WindowStartupLocation="CenterScreen">
    <!--This is the border for the whole window. It means that UI elemnts are positioned, at minimum, 15px away from the edge of the window.-->
    <Border Margin="15">
        <!--The base grid for the whole window.-->
        <Grid>
            <Grid.ColumnDefinitions>
                <!--The grid contains 3 columns, in the ratio 6 : 1 : 2-->
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="0.2*"></ColumnDefinition>
                <ColumnDefinition Width="0.8*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <!--The chessboard.-->
            <ItemsControl x:Name="itc_ChessBoard" >
                <ItemsControl.ItemsPanel>
                    <!--This panel creates all of the rows.-->
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}" dd:DragDrop.IsDropTarget="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Count}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <!--This DataTemplate is for each of the pieces on the board. -->
                                <DataTemplate>
                                    <Grid>
                                        <Rectangle x:Name="rct_Square" Fill="{Binding pos, Converter={StaticResource SquareConverter}}"/>
                                        <Image Source="{Binding piece,Converter={StaticResource PieceConverter}}"/>
                                        <Image Source="{Binding isLegalMove}"/>

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.Resources>
                                <Style TargetType="{x:Type Image}">
                                    <Setter Property="AllowDrop" Value="True"/>
                                </Style>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            





            <Grid Grid.Column="2" >
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="8*"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <!--Both the TextBlocks which act as the clocks-->
                <Border BorderThickness="2" BorderBrush="White">
                    <TextBlock x:Name="txt_ClockBlack" Style="{StaticResource Clock}" Text="5:00" Background="Black" Foreground="White"/>
                </Border>

                <Border BorderThickness="2" Grid.Row="2" BorderBrush="Black">
                    <TextBlock x:Name="txt_ClockWhite" Style="{StaticResource Clock}" Text="5:00" Background="White"/>
                </Border>
                



            </Grid>
        </Grid>
    </Border>
</Window>
