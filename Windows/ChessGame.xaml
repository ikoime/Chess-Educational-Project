<Window x:Class="Chess_Educational_Project.ChessGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chess_Educational_Project"
        mc:Ignorable="d"
        Title="Chess" Height="450" Width="800" Background="DarkGray" WindowStartupLocation="CenterScreen">
    <!--This is the border for the whole window. It means that UI elemnts are positioned, at minimum, 15px away from the edge of the window.-->
    <Border Margin="15">
        <!--The base grid for the whole window.-->
        <Grid>
            <Grid.ColumnDefinitions>
                <!--The grid contains 3 columns, in the ratio 6 : 1 : 4-->
                <ColumnDefinition Width="6*"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="4*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <!--The chessboard.-->
            <ItemsControl x:Name="itc_ChessBoard">
                <ItemsControl.ItemsPanel>
                    <!--This panel creates all of the rows.-->
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <!--This DataTemplate is for each of the pieces on the board. -->
                                <DataTemplate>
                                    <Grid>
                                        <Image x:Name="img_Piece" Source="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid x:Name="grd_Squares">
                
            </Grid>
            
            
            
            
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="4*"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <!--Both the TextBlocks which act as the clocks-->
                <Border BorderThickness="2" BorderBrush="Black">
                    <TextBlock x:Name="txt_ClockBlack" Style="{StaticResource Clock}" Text="5:00"/>
                </Border>

                <Border BorderThickness="2" Grid.Row="2" BorderBrush="Black">
                    <TextBlock x:Name="txt_ClockWhite" Style="{StaticResource Clock}" Text="5:00" />
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
