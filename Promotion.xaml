<Window x:Class="Chess_Educational_Project.Promotion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chess_Educational_Project"
        mc:Ignorable="d"
        Title="Promotion" Height="300" Width="75" Background="Gray" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid>
        <ItemsControl x:Name="itc_Promotion">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="4"></UniformGrid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding Converter={StaticResource PromotionOptionConverter}}" MouseDown="Image_MouseDown"></Image>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
