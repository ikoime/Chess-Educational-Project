<Application x:Class="Chess_Educational_Project.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Chess_Educational_Project"
             StartupUri="MainMenu.xaml">
    <Application.Resources>
        <!--This style is for the clocks.-->
        <Style TargetType="{x:Type TextBlock}" x:Key="Clock">
            <Style.Setters>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style.Setters>
        </Style>
        
        <!--All of the converters we will use in the project -->
        <local:SquareConverter x:Key="SquareConverter"/>
        <local:PieceConverter x:Key="PieceConverter"/>
        <local:ValidMoveConverter x:Key="ValidMoveConverter"/>
        <local:SelectionHighlightingConverter x:Key="SelectionHighligtingConverter"/>
        <local:PromotionOptionConverter x:Key="PromotionOptionConverter"/>

    </Application.Resources>
</Application>
